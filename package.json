{
  "name": "gree-hvac-client",
  "version": "4.2.0",
  "description": "A client for controlling Gree smart air conditioners",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint ./",
    "lint:fix": "eslint --fix ./",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "docs": "node scripts/docs.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "semantic-release": "semantic-release"
  },
  "types": "index.d.ts",
  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "example/probe.js",
    "CHANGELOG.md"
  ],
  "keywords": [
    "gree",
    "hvac",
    "air-conditioner",
    "climate",
    "ewpe",
    "home-automation",
    "smart-home",
    "udp",
    "node-red"
  ],
  "author": "Igor Starovierov <igor.decler@gmail.com>",
  "contributors": [
    "Andreas Pachler (https://github.com/apachler)"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "clone": "^2.1.2",
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.10.2",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jsdoc-to-markdown": "^9.1.3",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apachler/gree-hvac-client.git"
  },
  "bugs": {
    "url": "https://github.com/apachler/gree-hvac-client/issues"
  },
  "homepage": "https://github.com/apachler/gree-hvac-client#readme"
}
