{
  "name": "gree-hvac-client",
  "version": "4.3.0",
  "description": "A client for controlling Gree smart air conditioners",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "eslint ./",
    "lint:fix": "eslint --fix ./",
    "typecheck": "tsc -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "docs": "node scripts/docs.js",
    "audit": "npm audit --omit=dev --audit-level=high",
    "semantic-release": "semantic-release",
    "lint:lockfile": "lockfile-lint --path package-lock.json --type npm --allowed-hosts npm --validate-https --validate-package-names --allowed-package-name-aliases wrap-ansi-cjs:wrap-ansi strip-ansi-cjs:strip-ansi string-width-cjs:string-width @jest/react-is-18:react-is @jest/react-is-19:react-is"
  },
  "types": "index.d.ts",
  "files": [
    "src",
    "index.js",
    "index.d.ts",
    "example/probe.js",
    "CHANGELOG.md"
  ],
  "keywords": [
    "gree",
    "hvac",
    "air-conditioner",
    "climate",
    "ewpe",
    "home-automation",
    "smart-home",
    "udp",
    "node-red"
  ],
  "author": "Igor Starovierov <igor.decler@gmail.com>",
  "contributors": [
    "Andreas Pachler (https://github.com/apachler)"
  ],
  "license": "GPL-3.0-only",
  "dependencies": {
    "winston": "^3.17.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.1.0",
    "eslint-plugin-prettier": "^5.5.6",
    "fast-check": "^4.10.2",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "jsdoc-to-markdown": "^9.1.3",
    "lockfile-lint": "^5.1.0",
    "prettier": "^3.8.3",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apachler/gree-hvac-client.git"
  },
  "bugs": {
    "url": "https://github.com/apachler/gree-hvac-client/issues"
  },
  "homepage": "https://github.com/apachler/gree-hvac-client#readme"
}
