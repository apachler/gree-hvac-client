# gree-hvac-client environment overrides
#
# Every client option can be set via an environment variable (see
# src/client-options.js). Constructor options always win over env vars, and env
# vars win over the built-in defaults shown below.
#
# NOTE: the library does NOT auto-load this file (no dotenv dependency). Copy it
# to `.env` and source it yourself, export the vars in your shell, or use your
# process manager. This file is documentation + a template.

# GREE device IP address (use a unicast IP in production; the default is a broadcast address)
GREE_HVAC_HOST=192.168.1.255

# GREE device UDP port
GREE_HVAC_PORT=7000

# Only bind to the device with this MAC (cid), with or without colons. With a
# broadcast HOST this rediscovers the device by MAC after a DHCP address change.
#GREE_HVAC_MAC=f4911e000001

# Multi-split: control this indoor unit (its MAC from getSubUnits()); HOST/MAC
# then address the outdoor unit's WiFi module.
#GREE_HVAC_SUB_UNIT=c0000001a2b3c4

# Reconnect if no successful connection within this many ms
GREE_HVAC_CONNECT_TIMEOUT=3000

# Reconnect back-off cap (ms): the wait doubles per failed attempt, starting at
# CONNECT_TIMEOUT. Set it to CONNECT_TIMEOUT to retry at a fixed rate.
GREE_HVAC_RECONNECT_MAX_DELAY=30000

# Wait this many ms for a bind confirmation before retrying with AES-GCM
GREE_HVAC_BIND_TIMEOUT=1000

# Automatically connect when the client is created (set false to call connect() manually)
GREE_HVAC_AUTO_CONNECT=true

# Poll device properties
GREE_HVAC_POLL=true

# Polling interval (ms)
GREE_HVAC_POLLING_INTERVAL=3000

# Polling timeout (ms) — emits `no_response` if the device doesn't answer in time
GREE_HVAC_POLLING_TIMEOUT=1000

# Re-scan and re-bind after this many consecutive `no_response` events (0 disables)
GREE_HVAC_MAX_NO_RESPONSE=3

# Pause (ms) before re-scanning a device that stopped answering; later attempts
# back off from it up to RECONNECT_MAX_DELAY. 0 re-scans at once.
GREE_HVAC_RECOVERY_DELAY=0

# Open a new UDP socket for every reconnect attempt and after a socket error
# (some WiFi modules only recover that way without a power cycle)
GREE_HVAC_REOPEN_SOCKET=true

# Most vendor codes per status request; more are split over several requests
GREE_HVAC_STATUS_BATCH_SIZE=20

# Celsius setpoints in half degrees (firmwares with Add0.5 only)
GREE_HVAC_HALF_DEGREE=false

# targetHumidity is sent as (% - 15) / 5 (air conditioners with humidity control, e.g. Airy Pro)
GREE_HVAC_ENCODED_TARGET_HUMIDITY=false

# Least time between two set requests (ms); faster ones are queued. 0 disables it.
GREE_HVAC_COMMAND_INTERVAL=100

# Ask the unit not to beep on commands (units without a controllable beeper ignore it)
GREE_HVAC_SILENT=false

# Logging level: debug | info | warn | error
GREE_HVAC_LOG_LEVEL=error

# Deprecated: forces logLevel=debug. Prefer GREE_HVAC_LOG_LEVEL.
GREE_HVAC_DEBUG=false
